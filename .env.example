# 환경 (dev | prod). prod 시 로그 JSON, 메트릭 등
ENVIRONMENT=dev
LOG_LEVEL=INFO

# DB
HOST=localhost
PORT=3306
USERNAME=
PASSWORD=
DBNAME=streaming_pipeline_dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka (연결 정보만)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# CommandBus: kafka | stub (stub=로컬/테스트, Kafka 미사용)
COMMAND_BUS=kafka

# App
TZ=Asia/Seoul
HOST_IP=localhost

# (선택) GPU
NVIDIA_VISIBLE_DEVICES=0
